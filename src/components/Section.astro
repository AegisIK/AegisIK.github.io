---
interface Props {
  title: string;
  note?: string;
  id?: string;
}
const { title, note, id } = Astro.props;
---
<section class="section" id={id} aria-labelledby={id ? `${id}-h` : undefined}>
  <h2 id={id ? `${id}-h` : undefined}>{title}</h2>
  {note && <p class="section-note">{note}</p>}
  <hr class="rule" />
  <slot />
</section>
